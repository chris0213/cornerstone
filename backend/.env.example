# 数据库配置
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cornerstone
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/cornerstone

# 数据库连接池（仅 PostgreSQL 生效）
# 单副本最大连接数 = DB_POOL_SIZE + DB_MAX_OVERFLOW（默认 10 + 20 = 30）
# 多副本部署：副本数 × 30 + 迁移/监控等客户端 必须小于 PG max_connections
# 例：max_connections=100、3 副本 → 3×30=90，剩余 10 给运维连接，需下调池参数
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置
SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 初始管理员密码（首次启动创建 admin 用户时使用）
INITIAL_ADMIN_PASSWORD=change-me-before-deploy

# 凭证加密配置（可选，留空时首次运行会自动生成）
# CREDENTIAL_SECRET_KEY=

# 应用配置
APP_NAME=Cornerstone API
APP_VERSION=1.0.0
DEBUG=false

# 备份配置（持久化目录，确保有写权限）
BACKUP_DIR=/opt/cornerstone/backups

# CORS配置（允许的前端来源，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== SSO配置 ====================
# 启用SSO
SSO__ENABLED=false

# OAuth2配置（以Keycloak为例）
# SSO__CLIENT_ID=your-client-id
# SSO__CLIENT_SECRET=your-client-secret
# SSO__AUTHORIZE_URL=https://your-sso-server/auth/realms/your-realm/protocol/openid-connect/auth
# SSO__TOKEN_URL=https://your-sso-server/auth/realms/your-realm/protocol/openid-connect/token
# SSO__USERINFO_URL=https://your-sso-server/auth/realms/your-realm/protocol/openid-connect/userinfo
# SSO__REDIRECT_URL=http://localhost:5173/login

# SAML配置（可选）
# SSO__SAML_ENABLED=false
# SSO__IDP_METADATA_URL=https://your-idp/saml/metadata
# SSO__SP_ENTITY_ID=http://localhost:8000/saml/sp

# 登录方式优先级 (local, oauth2, saml)
SSO__LOGIN_METHODS=local,oauth2,saml