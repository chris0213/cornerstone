# Docker Compose 环境变量模板
# 使用方式：cp .env.docker.example .env  并修改下方值

# ==================== PostgreSQL ====================
POSTGRES_USER=cornerstone
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cornerstone

# ==================== JWT / 应用 ====================
# 生产环境请用 openssl rand -hex 32 生成 32 字节随机字符串
SECRET_KEY=change-me-to-a-random-32-bytes-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 首次启动时 admin 用户的初始密码
INITIAL_ADMIN_PASSWORD=change-me-admin-password

# 设备凭证加密密钥（留空则首次启动自动生成；建议显式指定以便迁移）
CREDENTIAL_SECRET_KEY=

# ==================== 应用配置 ====================
APP_NAME=Cornerstone API
APP_VERSION=1.0.0
DEBUG=false

# CORS 允许来源（多个用逗号分隔，需替换为生产域名）
CORS_ORIGINS=http://localhost,http://127.0.0.1

# 前端宿主机暴露端口
# 部署前请先执行：sudo ss -ltnp | grep -E ':(80|443|8080)\\b'
# 如果 80 被 Nginx/Apache 占用，可改为 8080，再用宿主机 Nginx 反向代理。
HTTP_PORT=80

# ==================== IP 白名单 ====================
# 可信代理：仅当后端的 TCP 直连 IP 命中此列表（IP/CIDR，逗号分隔）时，
# 才采信 X-Forwarded-For / X-Real-IP 头，白名单按客户端真实 IP 判定。
# Docker 部署默认信任 compose 内网（nginx 容器在此网段内）；宿主机 Nginx 反代请改为宿主机 IP。
# 未配置时后端只认直连 IP，白名单会对所有请求看到代理容器 IP（如 172.x.x.x）。
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
